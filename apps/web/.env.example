# --- Supabase (public: safe to expose, RLS protects data) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Web push (public half only) ---
# Generate a keypair with: npx web-push generate-vapid-keys
# The private key belongs in Supabase Edge Function secrets (VAPID_PRIVATE_KEY);
# only the public key is safe here. Without it the toggle on /notifications
# stays hidden and push is never offered.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Demo logins (development only) ---
# One-tap access to seeded accounts. Leave unset in production; middleware and
# the login page ignore it when absent.
NEXT_PUBLIC_DEMO_LOGINS=

# --- Paystack / server-only secrets ---
# These belong in Supabase Edge Function secrets, not browser code.
# Keep the names here as a deployment checklist only.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@bale-drop.test
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx   (optional)
# LAUNCH_DELIVERY_SUBSIDY_NAIRA=1500                        (0 disables)
# CRON_SECRET=replace-with-a-long-random-string

# --- Logistics (one provider for MVP) ---
SANDBOX_API_KEY=
KWIK_API_KEY=

# --- Notifications ---
# Email (Resend) and SMS (Termii). Either one alone is enough for the
# notification path to go live; both unset means in-app + push only.
TERMII_API_KEY=
TERMII_SENDER_ID=
RESEND_API_KEY=
RESEND_FROM=Bale Drop <orders@bale-drop.test>
