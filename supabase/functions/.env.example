# Local Edge Function secrets only. Copy to .env; never commit the copy.
# Hosted Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY for you.
# Set the same names with `supabase secrets set KEY=value` for production.

# --- Payments ---
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# --- Cron + webhooks ---
# Every scheduled function (bale-expiry, escrow-release) and every inbound
# webhook (paystack-webhook, logistics-webhook, push-send) checks its secret.
CRON_SECRET=replace-with-a-long-random-string
LOGISTICS_WEBHOOK_SECRET=replace-with-a-different-long-random-string

# --- URLs ---
SITE_URL=http://localhost:3000

# --- Launch delivery subsidy ---
# Server-authoritative: the amount is read here, never from the request body.
# Set to 0 to switch the subsidy off without a deploy of the web app.
LAUNCH_DELIVERY_SUBSIDY_NAIRA=1500

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM=Bale Drop <orders@bale-drop.test>

# --- SMS (Termii) ---
TERMII_API_KEY=
TERMII_SENDER_ID=

# --- Web push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
# Public key also goes in the web app as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# push-send refuses to run without the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@bale-drop.test

# --- Error monitoring (optional) ---
# Any Slack/Discord-style incoming webhook. Unset = errors are logged only.
ALERT_WEBHOOK_URL=
